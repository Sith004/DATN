# ==============================================================================
# BIẾN MÔI TRƯỜNG MẪU (ENV EXAMPLE) - ĐỒ ÁN TỐT NGHIỆP
# Sinh viên: Nguyễn Trọng Thể - MSSV: 1150080117
# ==============================================================================

# CÁCH 1: KẾT NỐI SUPABASE CLOUD POSTGRESQL (Khuyên dùng khi Deploy Cloud)
# Lấy chuỗi URI này tại: Supabase Dashboard -> Project Settings -> Database -> Connection URI
# Ví dụ: postgresql://postgres.abcdefghijklmnop:your_password@aws-0-ap-southeast-1.pooler.supabase.com:6543/postgres
DATABASE_URL=postgresql://postgres.your_project_ref:your_password@aws-0-ap-southeast-1.pooler.supabase.com:6543/postgres

# CÁCH 2: KẾT NỐI LOCAL POSTGRESQL HOẶC SSH TUNNEL
# (Được sử dụng khi DATABASE_URL để trống)
DB_HOST=127.0.0.1
DB_PORT=15432
DB_NAME=credit_risk_db
DB_USER=app_streamlit
DB_PASSWORD=your_password_here
DB_SSLMODE=prefer

# CẤU HÌNH FASTAPI BACKEND
PORT=8000
ENV=production
# CORS: Danh sách domain frontend cho phép gọi API (phân cách bởi dấu phẩy, hoặc * cho tất cả)
# Ví dụ: https://credit-risk-datn.vercel.app,http://localhost:3000
CORS_ORIGINS=*
